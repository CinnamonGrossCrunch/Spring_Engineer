# --------------------------------------------------------------------------
# Companion CAD service (cad-service/)
# --------------------------------------------------------------------------
# Base URL of the Python build123d/OpenCascade service that generates spring
# STEP geometry. Only the Next.js server reads this - it is never exposed to
# the browser, which always calls the local /api/cad/* proxy routes.
#
# Local development (see cad-service/README.md):
CAD_SERVICE_URL=http://localhost:8000

# Optional. How long the proxy waits for a CAD response, in milliseconds.
# Four states with STEP round-trip verification take a few seconds; the default
# is deliberately generous so a cold service fails clearly instead of hanging.
# CAD_TIMEOUT_MS=120000
